class Solution:
    def maxProfit(self, prices: list[int]) -> int:
        buy = prices[0] 
        sell = prices[0]
        profit = 0
        for i in range(1,len(prices)):
            if prices[i] < sell:
                profit += sell - buy
                buy = sell = prices[i]
            else:
                sell = prices[i]
        profit += sell - buy
        return profit
