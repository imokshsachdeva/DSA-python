class Solution:
    def longestConsecutive(self, nums: list[int]) -> int:
        nums = set(nums)
        maxcount = 0

        for n in nums:
            if n - 1 not in nums:
                count = 0
                while n in nums :
                    count += 1
                    n = n + 1
                maxcount = max(maxcount,count)
        
        return maxcount
