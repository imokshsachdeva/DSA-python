class Solution:
    def leftRightDifference(self, nums: List[int]) -> List[int]:
        lsum = 0
        rsum =0
        answer = []
        n = len(nums)
        for i in range(n):
            answer.append(lsum)
            lsum += nums[i]
        for i in range(n-1,-1,-1):
            answer[i] = abs(answer[i] - rsum)
            rsum += nums[i]
        return answer
