class Solution:
    def minSubArrayLen(self, target: int, nums: List[int]) -> int:
        min_length = float("inf")
        left = 0
        w_sum = 0
        for right in range(len(nums)):
            w_sum += nums[right]
            
            while w_sum >= target:
                length = right - left +1
                min_length = min(length,min_length)

                w_sum -= nums[left]
                left += 1

        return 0 if min_length == float("inf") else min_length
