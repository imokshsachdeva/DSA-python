class Solution:
    def findMaxAverage(self, nums: List[int], k: int) -> float:
        avg = 0
        for i in range(k):
            avg += (nums[i]/k)
        
        max_avg = avg
        for i in range(k,len(nums)):
            avg += (nums[i]/k)
            avg -= (nums[i - k]/k)
            max_avg = max(max_avg,avg)
        return max_avg
