class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        count = set()
        left =0
        maxlength = 0
        for right in range(len(s)):
            while s[right] in count:
                count.remove(s[left])
                left +=1
            count.add(s[right])
            maxlength = max(maxlength,right - left +1)
        return maxlength
