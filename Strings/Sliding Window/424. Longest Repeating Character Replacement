class Solution:
    def characterReplacement(self, s: str, k: int) -> int:
        mostfreq = 0
        maxlength = 0
        left =0
        mp = {}
        for right in range(len(s)):
            mp[s[right]] = mp.get(s[right],0) + 1
            mostfreq = max(mostfreq,mp.get(s[right]))
            while right - left + 1 > mostfreq + k :
                mp[s[left]] = mp.get(s[left]) - 1
                left += 1
            winlength = right - left + 1
            maxlength = max(maxlength,winlength)
        return maxlength
